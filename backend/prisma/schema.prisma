datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Game {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  platforms     Json
  genres        Json
  price         Float
  originalPrice Float?
  discount      Int
  releaseYear   Int
  thumbnail     String
  description   String?
  priceHistory  Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
